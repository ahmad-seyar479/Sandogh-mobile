#:import utils_font kivy.core.text.LabelBase

<RTLLabel@Label>:
    font_name: "PersianFont"
    halign: "right"
    valign: "middle"
    text_size: self.size
    color: 0.1, 0.1, 0.12, 1

<TitleLabel@Label>:
    font_name: "PersianFont"
    halign: "center"
    valign: "middle"
    text_size: self.size
    font_size: "22sp"
    bold: True
    color: 0.12, 0.35, 0.32, 1

<RTLButton@Button>:
    font_name: "PersianFont"
    font_size: "16sp"
    background_normal: ""
    background_color: 0.16, 0.45, 0.42, 1
    color: 1, 1, 1, 1

<SecondaryButton@Button>:
    font_name: "PersianFont"
    font_size: "16sp"
    background_normal: ""
    background_color: 0.55, 0.55, 0.58, 1
    color: 1, 1, 1, 1

<DangerButton@Button>:
    font_name: "PersianFont"
    font_size: "16sp"
    background_normal: ""
    background_color: 0.75, 0.22, 0.22, 1
    color: 1, 1, 1, 1

<RTLTextInput@TextInput>:
    font_name: "PersianFont"
    font_size: "16sp"
    halign: "right"
    padding: [12, 12, 12, 12]
    multiline: False

<TopBar@BoxLayout>:
    size_hint_y: None
    height: "52dp"
    canvas.before:
        Color:
            rgba: 0.16, 0.45, 0.42, 1
        Rectangle:
            pos: self.pos
            size: self.size
